# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# The SA password for the local SQL Server container.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend ---------------------------------------------------------------
# ASP.NET Core reads configuration from environment variables, where "__" means
# "nested section". Setting this overrides ConnectionStrings:Default from
# apps/api/src/SupportDesk.Presentation/appsettings.Development.json - useful if you run SQL Server elsewhere,
# or on another port.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# Development turns on Swagger, the automatic migration and the demo seed data.
ASPNETCORE_ENVIRONMENT=Development

# --- Authentication --------------------------------------------------------
# The key that signs and checks sign-in tokens (HMAC-SHA256): at least 32 bytes.
# Development has a placeholder in appsettings.Development.json; every other environment must
# set this, or the API refuses to start. Generate one, for example:
#   openssl rand -base64 48
# and never commit the real value.
Jwt__SigningKey=replace-with-at-least-32-random-bytes-from-a-secret-store

# --- API container (docker compose up --build) -----------------------------
# The api service reads MSSQL_SA_PASSWORD, Jwt__SigningKey and ASPNETCORE_ENVIRONMENT from this
# file and builds its own connection string to the "sqlserver" service, so ConnectionStrings__Default
# above (localhost) is not passed in. With no .env at all it runs as Production with local
# placeholder defaults; ASPNETCORE_ENVIRONMENT=Development also turns on Swagger at :5080/swagger.
# It always migrates and seeds an empty database (Database__MigrateAndSeedOnStartup, set in
# docker-compose.yml). Point the web app at it with:
#   VITE_API_PROXY_TARGET=http://localhost:5080 npm run web
